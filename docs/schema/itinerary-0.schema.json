{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Waiivyy/allstops/blob/main/docs/schema/itinerary-0.schema.json",
  "title": "allstops itinerary, schema version 0",
  "description": "A planned run that visits every target station, as written by `allstops solve`. Trips and stops are named by their GTFS IDs so the itinerary can be checked against the raw feed. Ride times are GTFS times of the ride's own service date; walk, wait and summary times are clock times of the plan date's service day. Both may exceed 24:00:00.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "feed", "timezone", "date", "rules", "targets", "legs", "summary", "lower_bound_s", "gap"],
  "properties": {
    "schema": { "const": "allstops-itinerary/0" },
    "feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "feed_version", "attribution"],
      "properties": {
        "id": { "type": "string", "description": "Registry ID, or `unregistered`." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the full feed zip." },
        "feed_version": { "type": "string" },
        "attribution": { "type": "string", "minLength": 1, "description": "Attribution text the feed's licence requires." }
      }
    },
    "timezone": { "type": "string", "minLength": 1, "description": "IANA time zone of the feed." },
    "date": { "$ref": "#/$defs/date", "description": "Plan date." },
    "rules": { "$ref": "#/$defs/rules" },
    "targets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Station IDs that must be visited."
    },
    "legs": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/ride" },
          { "$ref": "#/$defs/walk" },
          { "$ref": "#/$defs/wait" }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_visit", "last_visit", "duration_s", "stations_visited", "transfers", "walk_m"],
      "properties": {
        "first_visit": { "$ref": "#/$defs/time" },
        "last_visit": { "$ref": "#/$defs/time" },
        "duration_s": { "type": "integer", "minimum": 0, "description": "From the first target visit to the last." },
        "stations_visited": { "type": "integer", "minimum": 0 },
        "transfers": { "type": "integer", "minimum": 0, "description": "Changes between rides; staying aboard is not one." },
        "walk_m": { "type": "number", "minimum": 0 }
      }
    },
    "lower_bound_s": {
      "type": ["integer", "null"],
      "description": "A time no feasible itinerary for the same targets and rules can beat."
    },
    "gap": {
      "type": ["number", "null"],
      "description": "(duration minus lower bound) divided by the lower bound."
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": { "type": "string", "pattern": "^-?[0-9]{2,}:[0-5][0-9]:[0-5][0-9]$" },
    "clock": { "type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9]$" },
    "ride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "trip_id", "service_date", "route", "headsign", "board_stop_id", "board_time", "alight_stop_id", "alight_time", "stations"],
      "properties": {
        "type": { "const": "ride" },
        "trip_id": { "type": "string", "minLength": 1 },
        "service_date": { "$ref": "#/$defs/date" },
        "route": { "type": "string" },
        "headsign": { "type": "string" },
        "board_stop_id": { "type": "string", "minLength": 1 },
        "board_time": { "$ref": "#/$defs/time" },
        "alight_stop_id": { "type": "string", "minLength": 1 },
        "alight_time": { "$ref": "#/$defs/time" },
        "stations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Stations this ride visits, in order."
        },
        "stay_aboard": {
          "const": true,
          "description": "Present only when the runner stays aboard from the previous ride, whose vehicle continues as this trip."
        }
      }
    },
    "walk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from_station", "to_station", "start", "end", "metres", "walking_speed_kmh"],
      "properties": {
        "type": { "const": "walk" },
        "from_station": { "type": "string" },
        "to_station": { "type": "string" },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "metres": { "type": "number", "minimum": 0, "description": "Straight-line distance." },
        "walking_speed_kmh": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "station", "start", "end"],
      "properties": {
        "type": { "const": "wait" },
        "station": { "type": "string" },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "description": "The rules the run was planned under (docs/RULES.md).",
      "required": ["mode", "selection", "date", "earliest_start", "latest_end", "start", "end", "allow_walking", "walking_speed_kmh", "walk_detour_factor", "max_walk_m", "connector_modes", "min_transfer_s", "tight_transfer_s", "count_pass_through", "stay_aboard_through_terminus"],
      "properties": {
        "mode": { "const": "stops" },
        "selection": { "type": "string" },
        "station_overrides": { "type": "string" },
        "walks": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "earliest_start": { "$ref": "#/$defs/clock" },
        "latest_end": { "$ref": "#/$defs/clock" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "allow_walking": { "type": "boolean" },
        "walking_speed_kmh": { "type": "number" },
        "walk_detour_factor": { "type": "number" },
        "max_walk_m": { "type": "number" },
        "connector_modes": { "type": "array", "items": { "type": "string" } },
        "min_transfer_s": {
          "type": "object",
          "additionalProperties": false,
          "required": ["same_station", "walk_link"],
          "properties": {
            "same_station": { "type": "integer", "minimum": 1 },
            "walk_link": { "type": "integer", "minimum": 1 }
          }
        },
        "tight_transfer_s": { "type": "integer", "minimum": 0 },
        "count_pass_through": { "type": "boolean" },
        "stay_aboard_through_terminus": { "type": "boolean" }
      }
    }
  }
}
